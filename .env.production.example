# DebtScope — PRODUCTION environment template
# Copy to .env on the server (never commit the filled-in file) and replace every <...>.
# The backend refuses to start in production if any secret below is missing or a known default.
#
# Generate secrets:
#   SECRET_KEY / JWT_SECRET / POSTGRES_PASSWORD:
#     python -c "import secrets; print(secrets.token_hex(32))"
#   TOKEN_ENCRYPTION_KEY:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False
DEV_SANDBOX_AUTH=False
JIRA_SIMULATION_MODE=False
NOTION_SIMULATION_MODE=False

SECRET_KEY=<random-64-hex>
JWT_SECRET=<random-64-hex>
TOKEN_ENCRYPTION_KEY=<fernet-key>

# ── Database (docker-compose builds DATABASE_URL from these) ─────────────────
POSTGRES_DB=debtscope
POSTGRES_USER=debtscope_admin
POSTGRES_PASSWORD=<random-64-hex>
# Outside docker-compose (managed Postgres), set the full URL instead:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<db>

# ── Public URLs (HTTPS required: session cookies are Secure in production) ───
FRONTEND_URL=https://<your-domain>
ALLOWED_ORIGINS=["https://<your-domain>"]
GOOGLE_REDIRECT_URI=https://<your-api-domain>/api/v1/auth/google/callback

# ── Google OAuth (add the redirect URI above in Google Cloud → Clients) ──────
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=<github-token>

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_API_KEY=<notion-token>
NOTION_DATABASE_ID=<32-hex-database-id>

# ── Optional: Jira, AI Copilot ───────────────────────────────────────────────
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://<your-api-domain>/api/v1/integrations/jira/callback
JIRA_PROJECT_KEY=DEBT
COPILOT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
