# DebtScope Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to git — it is in .gitignore.
# See docs/MANUAL_STEPS.md for step-by-step instructions.

# ── App ───────────────────────────────────────────────────────────────────────
# IMPORTANT: DebtScope defaults to fail-closed production mode (ENVIRONMENT=production).
# Local development requires an explicit ENVIRONMENT=development.
# In production, startup refuses to run if SECRET_KEY, JWT_SECRET, or TOKEN_ENCRYPTION_KEY
# are missing, default, or insecure.
ENVIRONMENT=development
DEBUG=True

# In production, generate strong random secrets:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-32-random-chars
JWT_SECRET=change-me-in-production-32-random-chars

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev default)
DATABASE_URL=sqlite:///./tech_debt_intelligence.db
# PostgreSQL (production / Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debtscope_db

# ── Auth ──────────────────────────────────────────────────────────────────────
# DEV_SANDBOX_AUTH: bypass real Google OAuth for local/test use.
# MUST be False in production or server refuses to start.
DEV_SANDBOX_AUTH=False

# Fernet key for encrypting OAuth tokens at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── Google OAuth 2.0 (see docs/MANUAL_STEPS.md § Google) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── GitHub (see docs/MANUAL_STEPS.md § GitHub) ───────────────────────────────
# Personal Access Token (read-only: repo contents) for public + private repos
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App (optional, for private repo installs)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=

# ── Jira OAuth 2.0 3LO (see docs/MANUAL_STEPS.md § Jira) ────────────────────
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:5173/auth/jira/callback
JIRA_PROJECT_KEY=DEBT

# ── Notion (see docs/MANUAL_STEPS.md § Notion) ──────────────────────────────
# Internal integration token + Service Criticality database ID (32 hex chars)
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:5173/auth/notion/callback

# ── Frontend & CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# JSON list of extra origins allowed to call the API with cookies. Never "*".
# ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Docker Compose only ───────────────────────────────────────────────────────
# Required by docker-compose.yml (it refuses to start without it).
POSTGRES_PASSWORD=

# ── AI Copilot LLM Provider (Phase 3.5 — see docs/MANUAL_STEPS.md § Copilot) ───
# Provider selector: 'gemini' (default) or 'claude'
COPILOT_LLM_PROVIDER=gemini
# Google Gemini API Key
GEMINI_API_KEY=
# Anthropic Claude API Key
ANTHROPIC_API_KEY=

